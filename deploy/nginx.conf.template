# nginx config for the agent-browser MCP tunnel
# Rendered with envsubst: ${MCP_AUTH_TOKEN} and ${MCP_PORT}
# Runs unprivileged on the Actions runner, listens on :80 because the
# Cloudflare tunnel ingress points at http://localhost (port 80).

worker_processes 1;
pid /tmp/nginx.pid;
error_log /tmp/abmcp-logs/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    access_log /tmp/abmcp-logs/nginx-access.log;
    client_body_temp_path /tmp/nginx-client;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    # MCP over streamable HTTP uses long-lived SSE streams — no buffering,
    # generous timeouts (mirrors the tunnel's origin config)
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 999999s;
    proxy_send_timeout 999999s;
    proxy_connect_timeout 999999s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    chunked_transfer_encoding on;

    server {
        listen 80 default_server;
        server_name _;

        # unauthenticated liveness probe (used by the watchdog + healthz)
        location = /healthz {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location / {
            # bearer-token gate — the tunnel hostname is public
            if ($http_authorization != "Bearer ${MCP_AUTH_TOKEN}") {
                return 401 "unauthorized\n";
            }

            proxy_pass http://127.0.0.1:${MCP_PORT};
        }
    }
}
